    "lint": "eslint src/"
  },
  "dependencies": {
    "@designlasagna/schemas": "^0.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "glob": "^11.0.0",
    "jsonc-parser": "^3.3.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
